{
  "crons": [
    { "path": "/api/cron/reminders", "schedule": "* * * * *" },
    { "path": "/api/cron/daily",     "schedule": "0 11 * * *" },
    { "path": "/api/cron/weekly",    "schedule": "0 11 * * 1" },
    { "path": "/api/cron/monthly",   "schedule": "0 11 1 * *" }
  ],
  "functions": {
    "api/**": { "maxDuration": 30 }
  }
}
